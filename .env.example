# Datasec MCP – Beispiel-Umgebung (kein echtes Token hier ablegen!)

# test | prod  (Standard: test)
DATASEC_ENV=test

# Token bevorzugen aus Datei (nie ins Repo committen):
# Box:  /workspace/datasec_shared/datasec_token.env
# PC:   C:\Users\j.bothe\AppData\Local\Temp\datasec_probe\datasec_token.env
DATASEC_TOKEN_FILE=/workspace/datasec_shared/datasec_token.env

# Alternativ direkt (nur für lokale Tests, nicht committen):
# DATASEC_TOKEN=

# Schreibzugriff (John: default true). Zum Sperren: false
DATASEC_WRITES_ENABLED=true

# Write-Tools brauchen confirm:true (Standard: true)
DATASEC_REQUIRE_CONFIRM=true

# L1 Freitext-Helpers (datasec_h_*). Default true. Raw-Tools bleiben immer aktiv.
DATASEC_HELPERS_ENABLED=true

# Optional: writable address cache (default data/address-crosswalk.json). TTL 24h.
# DATASEC_ADDRESS_CACHE_PATH=

# Nur Remote/HTTP:
PORT=8788
# Optionaler Gate für Remote – wenn gesetzt, Bearer oder x-api-key nötig
# MCP_API_KEY=

# Multi-Key-Auth (HTTP):
# MCP_KEYS_FILE=/pfad/zu/keys.json
# Fallback einzelner Key (admin, test+prod), falls nicht in keys.json:
# MCP_API_KEY=
# Ohne keys.json und ohne MCP_API_KEY ist HTTP gesperrt (Default).
# Nur zum Debuggen lokal: MCP_ALLOW_ANON=true
# Optionaler Desk-Pfad für keys.json-Suche:
# DATASEC_DESK=
