{
  "name": "datasec-mcp",
  "version": "1.0.0",
  "description": "Vendor-neutral MCP server for Datasec DOKU@WEB (read + write)",
  "type": "module",
  "main": "dist/index-stdio.js",
  "bin": {
    "datasec-mcp": "./dist/index-stdio.js",
    "datasec-mcp-http": "./dist/index-http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index-stdio.js",
    "start:http": "node dist/index-http.js",
    "dev": "tsx src/index-stdio.ts",
    "dev:http": "tsx src/index-http.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["mcp", "datasec", "dokuweb", "tickets"],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
